# goexchange nginx config
# 
# Routes:
#   HTTP (80)   → redirect to HTTPS
#   HTTPS (443) → /         → static web (vite dist/)
#                → /api/*    → Go API (:8099)

# HTTP server - redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name goexchange.top www.goexchange.top;

    # ACME challenge for Let's Encrypt (renewal)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# WebSocket upgrade map
map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name goexchange.top www.goexchange.top;

    # SSL certificates (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/goexchange.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/goexchange.top/privkey.pem;

    # SSL config (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Serve static web (vite dist/)
    root /var/www/html;
    index index.html;

    # SPA fallback - any unknown path serves index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy
    location /api/ {
	# WebSocket proxy for orderbook (real-time orderbook updates) - direct to matcher
	location /api/v1/ws/orderbook {
		proxy_pass http://127.0.0.1:8098/ws;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		proxy_read_timeout 86400;
	}
	# WebSocket proxy for notifications
	location /api/v1/ws/ {
		proxy_pass http://127.0.0.1:8099;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		proxy_read_timeout 86400;
	}	
	location /api/v1/ws {
		proxy_pass http://127.0.0.1:8099/api/v1/ws;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		proxy_read_timeout 86400;
	}
        proxy_pass http://127.0.0.1:8099/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana monitoring dashboard (M6.120)
    # Basic Auth: admin / admin123
    location /grafana/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        auth_basic "goexchange Grafana";
        auth_basic_user_file /etc/nginx/.htpasswd_grafana;
    }

    # Prometheus (read-only via /prometheus/)
    location = /prometheus/ { return 301 /prometheus/targets; }
    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        auth_basic "goexchange Prometheus";
        auth_basic_user_file /etc/nginx/.htpasswd_grafana;
    }

    # WebSocket proxy to matcher
    location /ws {
        proxy_pass http://127.0.0.1:8098/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
