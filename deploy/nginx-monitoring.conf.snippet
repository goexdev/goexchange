# Nginx configuration snippet for monitoring routes.
# Add to your existing HTTPS server block (e.g. /etc/nginx/sites-enabled/goexchange)
#
# Provides:
#   /grafana/    → Grafana UI (Basic Auth)
#   /prometheus/ → Prometheus UI (Basic Auth)
#
# Prerequisites:
#   1. Grafana running on localhost:3001 (Docker)
#   2. Prometheus running on localhost:9090 (Docker)
#   3. htpasswd file at /etc/nginx/.htpasswd_grafana

# Inside your existing server { listen 443 ssl http2; ... } block:

    # Grafana monitoring dashboard (M6.120)
    # Basic Auth: admin / admin123
    location /grafana/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        auth_basic "goexchange Grafana";
        auth_basic_user_file /etc/nginx/.htpasswd_grafana;
    }

    # Prometheus (read-only via /prometheus/)
    location = /prometheus/ { return 301 /prometheus/targets; }
    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        auth_basic "goexchange Prometheus";
        auth_basic_user_file /etc/nginx/.htpasswd_grafana;
    }

# Setup commands:
#
#   # Install htpasswd
#   apt install -y apache2-utils
#
#   # Create password file
#   htpasswd -c /etc/nginx/.htpasswd_grafana admin
#   # (enter password when prompted)
#
#   # Test nginx config
#   nginx -t
#
#   # Reload nginx
#   systemctl reload nginx
#
# Access:
#   https://yourdomain.com/grafana/    (admin / admin123)
#   https://yourdomain.com/prometheus/ (admin / admin123)
