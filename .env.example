# .env.example for goexdev-public
#
# Copy to .env, fill in real values, and `docker compose up -d`.
#
# Variables in this file are consumed by:
#   * config.yaml loader (overrides yaml defaults)
#   * docker-compose.yml (passed to service containers as env)
#
# Anything left at its example default will NOT start a real deployment
# in production. Generate a real JWT secret with:
#   openssl rand -hex 32
# A real Vault token with:
#   vault token create -policy=goexchange

# ---- API / scheduler shared ----

# PostgreSQL connection string. Use the docker-compose service name
# (postgres) when running inside the compose network.
DATABASE_URL=postgres://exchange:exchange@postgres:5432/exchange?sslmode=disable

# Where to reach the matching engine. When matching runs as a docker
# service (the production target), this is the docker-network name
# and gRPC port. When matching runs on the host, use localhost.
# MATCHING_URL=localhost:50051
MATCHING_URL=matching:50051

# JWT signing secret. MUST be at least 32 hex characters in
# production. The example value below is the dev placeholder and
# is rejected by the loader if JWT_SECRET is required and the
# fallback is in use.
JWT_SECRET=please_change_me_to_a_random_64_char_hex_string

# ---- Vault ----

# When true, the API loads DB password, JWT secret, and other
# secrets from Vault at boot instead of from config.yaml. In a
# local docker-compose setup you typically run vault as a
# container too and point VAULT_ADDR at it.
VAULT_ENABLED=true

# VAULT_ADDR:
#   - API running on host (deploy-fresh.sh default): use the
#     host-mapped port, e.g. http://127.0.0.1:8200
#   - API running inside docker-compose: use the service name,
#     e.g. http://vault:8200
# deploy-fresh.sh patches this to 127.0.0.1:8200 on host deploys
# so the example value below is the host form. Switch to
# http://vault:8200 only if you intend to run the API in a
# container too.
VAULT_ADDR=http://127.0.0.1:8200

# VAULT_TOKEN / VAULT_AUTH_METHOD:
#   - For local dev with the compose dev-mode root token, set
#     VAULT_AUTH_METHOD=static (or omit) and VAULT_TOKEN to the
#     root token (compose VAULT_DEV_ROOT_TOKEN_ID).
#   - For production-like deploys, set VAULT_AUTH_METHOD=approle
#     and VAULT_TOKEN to a freshly-rotated secret_id. The
#     matching role_id lives in config.yaml under vault.app_role_id.
#     deploy-fresh.sh's Step 3.5 generates a fresh secret_id and
#     writes it here automatically.
VAULT_AUTH_METHOD=approle
VAULT_TOKEN=please_change_me

# ---- Optional / nice-to-have ----

# Redis is currently used for rate limiting and notifications. The
# API will start without it but those features will be disabled.
REDIS_ADDR=redis:6379

# Domain the web frontend is served from. Used to build CORS
# allow-lists at startup.
VITE_DOMAIN=goexchagne.top

# SMTP for outbound email. Defaults match the mailhog service
# below; production deployments should override these.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=goexchagne@goexchagne.top
