#!/bin/bash
# Pre-commit hook for the public goexchange repo.
#
# Targets:   /root/goexchange-public/  (this repo)
# Companion: /root/goexchange-core/     (closed-source matching; plain build only)
#
# Install:   git config core.hooksPath .githooks
#
# Checks:
#   1. Zero-tolerance string scan: banned privacy string (BOSS GitHub handle)
#   2. Public repo:  go vet, go build, tsc, vitest
#   3. Core repo:    go vet, plain go build (matching only; no garble here)
#
# Each check writes a log under /tmp; on failure the last 20 lines are
# echoed so the commit author can see what broke.

set -e

echo "Running pre-commit QA checks..."

# 0. Zero-tolerance strings (privacy + repo rename).
#    Scan ONLY the two git repos. Skip .git, build caches, vendored
#    node_modules, build outputs. Do NOT scan the archived monorepo
#    under /root/goexchange/ — it is intentionally frozen and not part
#    of the new repo split.
#
#    The banned strings themselves are stored in a separate excluded
#    config file (see .githooks/banned-strings.conf) so that this
#    hook script never contains the literal privacy tokens or the
#    legacy repo name. That way the privacy tokens are not exposed
#    in commit content.
PRIVACY_FAIL=0
for repo in /root/goexchange-public /root/goexchange-core; do
    if [ -d "$repo" ]; then
        PATTERN_FILE="$(dirname "$0")/banned-strings.conf"
        if [ ! -f "$PATTERN_FILE" ]; then
            PATTERN_FILE=".githooks/banned-strings.conf"
        fi
        if [ -f "$PATTERN_FILE" ] && grep -rln -E -f "$PATTERN_FILE" \
                --exclude-dir=.git \
                --exclude-dir=node_modules \
                --exclude-dir=dist \
                --exclude-dir=.cache \
                --exclude-dir=bin \
                --exclude=pre-commit \
                --exclude=.env \
                --exclude=.env.example \
                --exclude=README.md \
                --exclude=banned-strings.conf \
                "$repo" > /tmp/precommit-privacy.log 2>&1; then
            echo "FAIL: zero-tolerance string(s) found in $repo:"
            cat /tmp/precommit-privacy.log
            PRIVACY_FAIL=1
        fi
    fi
done
if [ "$PRIVACY_FAIL" = "1" ]; then
    exit 1
fi

# 1. Public repo: Go vet + build.
cd /root/goexchange-public
if ! /usr/local/go/bin/go vet ./... > /tmp/precommit-pub-vet.log 2>&1; then
    echo "FAIL: public repo go vet"
    tail -20 /tmp/precommit-pub-vet.log
    exit 1
fi
if ! /usr/local/go/bin/go build ./... > /tmp/precommit-pub-build.log 2>&1; then
    echo "FAIL: public repo go build"
    tail -20 /tmp/precommit-pub-build.log
    exit 1
fi

# 2. Public web: tsc + vitest (skip if web/node_modules missing).
if [ -d /root/goexchange-public/web/node_modules ]; then
    if ! (cd /root/goexchange-public/web && npx tsc --noEmit) > /tmp/precommit-tsc.log 2>&1; then
        echo "FAIL: web tsc"
        tail -20 /tmp/precommit-tsc.log
        exit 1
    fi
    if ! (cd /root/goexchange-public/web && ./node_modules/.bin/vitest run) > /tmp/precommit-vitest.log 2>&1; then
        echo "FAIL: web vitest"
        tail -20 /tmp/precommit-vitest.log
        exit 1
    fi
fi

# 3. Core repo: vet + plain build of matching binary.
#    Plain build (no garble) so we keep debug info; garble is only for the
#    release image. Skip cleanly if the core repo is not on this machine.
if [ -d /root/goexchange-core ]; then
    cd /root/goexchange-core
    if ! /usr/local/go/bin/go vet ./... > /tmp/precommit-core-vet.log 2>&1; then
        echo "FAIL: core repo go vet"
        tail -20 /tmp/precommit-core-vet.log
        exit 1
    fi
    if ! GOTOOLCHAIN=auto /usr/local/go/bin/go build -o /tmp/precommit-matching ./cmd/matching > /tmp/precommit-core-build.log 2>&1; then
        echo "FAIL: core repo go build (matching)"
        tail -20 /tmp/precommit-core-build.log
        exit 1
    fi
    rm -f /tmp/precommit-matching
fi

echo "Pre-commit checks passed"